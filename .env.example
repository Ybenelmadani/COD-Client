# À mettre dans Vercel > Settings > Environment Variables (jamais dans le code ni dans client/)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/codshield
JWT_SECRET=une-chaine-aleatoire-tres-longue
# Clé secrète pour le hash des téléphones. NE JAMAIS la perdre ni la changer.
PHONE_PEPPER=une-autre-chaine-aleatoire-tres-longue
# Email du compte administrateur (le seul à accéder à /admin et /api/admin/*)
ADMIN_EMAIL=votre-email-admin@exemple.ma
